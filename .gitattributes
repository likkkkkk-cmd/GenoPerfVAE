*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.pkl binary
*.pickle binary
*.pth binary
*.pt binary
*.gz binary
